# Required server settings. Never commit real values to Git or place them in Flutter/web files.
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ROTATED_SERVICE_ROLE_KEY
ADMIN_KEY=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Comma-separated allowed origins for the web admin panel.
# Example: https://admin.example.com,https://www.example.com
CORS_ORIGIN=https://YOUR_ADMIN_PANEL_ORIGIN

# Optional integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TMDB_TOKEN=
AUTO_FAILOVER=0
